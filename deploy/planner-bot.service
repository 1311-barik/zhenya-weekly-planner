[Unit]
Description=sheyn's planner — Telegram bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/planner
Environment=TZ=Europe/Paris
ExecStart=/usr/bin/node --env-file=/var/www/planner/.env /var/www/planner/bot/bot.mjs
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
